{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pumper",
  "compatibility_date": "2026-07-18",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "pumper.wolf-yuan.dev",
      "custom_domain": true
    }
  ]
}
