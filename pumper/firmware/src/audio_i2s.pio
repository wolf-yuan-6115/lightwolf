; I2S, MSB first. The 16-bit program consumes one packed stereo word per frame;
; the 32-bit program consumes right then left words with 24 valid MSBs.

.program audio_i2s_16
.side_set 2
right16:
    out pins, 1       side 0b10
    jmp x-- right16   side 0b11
    out pins, 1       side 0b00
    set x, 14         side 0b01
left16:
    out pins, 1       side 0b00
    jmp x-- left16    side 0b01
    out pins, 1       side 0b10
public entry16:
    set x, 14         side 0b11

.program audio_i2s_32
.side_set 2
right32:
    out pins, 1       side 0b10
    jmp x-- right32   side 0b11
    out pins, 1       side 0b00
    set x, 30         side 0b01
left32:
    out pins, 1       side 0b00
    jmp x-- left32    side 0b01
    out pins, 1       side 0b10
public entry32:
    set x, 30         side 0b11

% c-sdk {
static inline void audio_i2s_program_init(PIO pio, uint sm, uint offset, uint entry,
                                          uint data_pin, uint clock_pin_base,
                                          pio_sm_config config) {
    sm_config_set_out_pins(&config, data_pin, 1);
    sm_config_set_sideset_pins(&config, clock_pin_base);
    sm_config_set_out_shift(&config, false, true, 32);
    sm_config_set_fifo_join(&config, PIO_FIFO_JOIN_TX);
    pio_sm_init(pio, sm, offset, &config);
#if PICO_PIO_USE_GPIO_BASE
    uint64_t pin_mask = (1ull << data_pin) | (3ull << clock_pin_base);
    pio_sm_set_pindirs_with_mask64(pio, sm, pin_mask, pin_mask);
#else
    uint32_t pin_mask = (1u << data_pin) | (3u << clock_pin_base);
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask);
#endif
    pio_sm_set_pins(pio, sm, 0);
    pio_sm_exec(pio, sm, pio_encode_jmp(offset + entry));
}
%}
